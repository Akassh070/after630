# Copy to .env.local and fill in real values. Nothing here is required to run
# the site locally — the cloud name and WhatsApp number have built-in defaults
# in src/content/site.ts.

# Cloudinary — needed ONLY for `npm run images:upload`
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=idavlcrv
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: folder with local WebPs used only as upload sources (not served
# by the site). Point at an extracted image pack, e.g. homepage or remaining pages.
# AFTER630_LOCAL_IMAGES_DIR=/absolute/path/to/After630_Remaining_Pages_Images

# Optional overrides
# NEXT_PUBLIC_AFTER630_WHATSAPP_NUMBER=
# NEXT_PUBLIC_INSTAGRAM_URL=
# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_ALLOW_INDEXING=
# NEXT_PUBLIC_META_PIXEL_ID=
